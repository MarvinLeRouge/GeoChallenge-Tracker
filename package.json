{
  "name": "geochallenge-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "lint": "eslint frontend/src frontend/tests --ext .ts,.tsx,.vue --max-warnings=0",
    "lint:fix": "eslint frontend/src frontend/tests --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write frontend/src frontend/tests",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build:test && playwright test",
    "test:e2e:ui": "npm run build:test && playwright test --ui",
    "test:e2e:headed": "npm run build:test && playwright test --headed",
    "tests:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.72.0",
    "axios": "^1.21.0",
    "flowbite": "^3.1.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.markercluster": "^1.5.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.45",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.8",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.6.2",
    "dompurify": "^3.2.7",
    "dotenv": "^18.0.10",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.47.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.3",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "esbuild": "^0.25.2"
  }
}
