# Template for /home/mlr/marvinlerouge.dev/gc-tracker/shared/env/app.env on the VPS (chmod 600).
# Non-secret settings, loaded into the containers through env_file in docker-compose.prod.yml.
# Secrets go to secrets.env (see secrets.env.example), loaded after this file so it wins.
# Local development keeps the single root .env (see .env.example).

APP_NAME=GeoChallenge
API_VERSION=
ENVIRONMENT=production
SUPPORT_URL=
SEED_ON_STARTUP=true

# CORS (JSON list)
CORS_ORIGINS=["https://gc-tracker.marvinlerouge.dev"]

# Base URL of the links sent by email
APP_FRONTEND_URL=https://gc-tracker.marvinlerouge.dev
MAIL_FROM=

# Backups, bind-mounted from shared/backups
BACKUP_DIR=/backups

# Upload limits
ONE_MB=1048576
MAX_UPLOAD_MB=20

# Elevation
ELEVATION_PROVIDER=opentopo
ELEVATION_PROVIDER_ENDPOINT=https://api.opentopodata.org/v1/mapzen
ELEVATION_PROVIDER_MAX_POINTS_PER_REQ=100
ELEVATION_PROVIDER_RATE_DELAY_S=1
ELEVATION_ENABLED=1

# Error tracking
SENTRY_ENVIRONMENT=production
