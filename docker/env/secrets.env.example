# Template for /home/mlr/marvinlerouge.dev/gc-tracker/shared/env/secrets.env on the VPS (chmod 600).
# Loaded into the backend container after app.env through env_file in docker-compose.prod.yml.
# Each topic holding a secret is kept whole here (its non-secret keys included). Never commit the real file.
# Local development keeps the single root .env (see .env.example).

# MongoDB ([[MONGODB_USER]] and [[MONGODB_PASSWORD]] in the template are replaced with the values below)
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_URI_TPL=mongodb+srv://[[MONGODB_USER]]:[[MONGODB_PASSWORD]]@cluster0.yourcluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=

# JWT (generate the key with: openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Seeded admin account, and default recipient of POST /maintenance/test-email
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TEST_EMAIL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Sentry: leave empty to disable. SENTRY_FRONTEND_DSN must match the VITE_SENTRY_DSN GitHub secret exactly.
SENTRY_BACKEND_DSN=
SENTRY_FRONTEND_DSN=
